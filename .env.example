# PostgreSQL connection string used by Drizzle ORM and drizzle-kit.
# When running via Docker Compose, the app builds this from the
# POSTGRES_* vars below instead, so this is mainly for local (non-Docker) dev.
DATABASE_URL=postgres://pulsegrid:pulsegrid@localhost:5432/pulsegrid

# Credentials for the Postgres container started by docker-compose.
POSTGRES_USER=pulsegrid
POSTGRES_PASSWORD=pulsegrid
POSTGRES_DB=pulsegrid

# Password required to access /admin/leads. Use a long, random value in production.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Use a long, random value in production.
SESSION_SECRET=change-me-too

# Brevo SMTP relay credentials (Transactional > SMTP & API in the Brevo dashboard).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender and recipient for new-lead notification emails.
EMAIL_FROM="Pulsegrid <no-reply@example.com>"
EMAIL_TO=sales@example.com

# Comma-separated hostnames the Angular SSR server will accept in the
# Host header. "localhost" works for local Docker Compose; set this to
# your production domain (e.g. example.com) when deploying.
NG_ALLOWED_HOSTS=localhost
